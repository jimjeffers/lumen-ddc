pkgname=lumen-ddc
pkgver=0.4.0
pkgrel=1
pkgdesc='Monitor brightness, color and picture modes over DDC/CI'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'ddcutil')
makedepends=('gcc' 'make')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/lumen-ddc "$pkgdir/usr/bin/lumen-ddc"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/lumen-ddc.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/lumen-ddc.svg"
  install -Dm644 "$startdir/lumen-ddc.desktop" "$pkgdir/usr/share/applications/lumen-ddc.desktop"
}
